  "help": {
    "title": "Feature Guide",
    "grpcCall": "gRPC Calls",
    "grpcCallDesc": "Supports Unary, Server Streaming, Client Streaming, and Bidi Streaming. Enter the server address, select a method from the sidebar, edit the request body, and click Send.",
    "grpcCallTip": "⌘+Enter to send",
    "protoImport": "Proto Import",
    "protoImportDesc": "Import .proto files, directories, or use Server Reflection to auto-discover services. The service tree appears in the sidebar after import.",
    "protoImportTip": "⌘+R to reload",
    "defaultAddress": "Default Address",
    "defaultAddressDesc": "Click the star in the saved-address dropdown to set an address as the default. Empty startup tabs and ordinary new tabs use it automatically and load its TLS settings. Without a default, new tabs keep inheriting the current address and TLS state.",
    "metadata": "Metadata",
    "metadataDesc": "Add request headers in the Metadata tab. Supports key-value editing and JSON bulk import; valid JSON is applied to the current request automatically. From a JSON response, save fields as address default Metadata; later requests to the same address auto-attach them. Hover the status bar to view full key/value pairs, then refresh, disable, edit the profile name/key/value, and save. Manual keys still win conflicts.",
    "environment": "Environments",
    "environmentDesc": "Switch environments from the title bar. Manage variables per environment. Use {{varName}} in request body and metadata — values are auto-replaced on send.",
    "collections": "Collections",
    "collectionsDesc": "Save frequently used requests to collections. Click the bookmark icon next to the address bar to save. Manage and quick-load from the Collections panel in the sidebar.",
    "history": "History",
    "historyDesc": "The bottom panel auto-records every request. Click a record to replay in a new tab. ⌘+Click to select two records for Diff comparison.",
    "historyTip": "⌘+Click to compare",
    "benchmark": "Benchmark",
    "benchmarkDesc": "Configure concurrency, request count, duration, or target QPS in the Benchmark tab. Supports ramp-up and variable injection. View real-time QPS and latency charts. Export results as JSON/CSV/HTML.",
    "chain": "Chain Requests",
    "chainDesc": "Orchestrate sequential requests in the Chain tab. Use {{prev.field}} to reference previous step's response fields. Supports fuzzy search for service and method selection.",
    "mock": "Mock Server",
    "mockDesc": "Configure rules and start a local gRPC Mock server in the Mock tab. Set status codes, delays, and custom response bodies for frontend development.",
    "decode": "Payload Decode",
    "decodeDesc": "Use the Decode tab to parse hex/base64/escaped/raw binary payloads into readable JSON. Supports batch decode, diff view, nested field decode, and persistent history. Raw and tree response views replace base64 protobuf bytes fields with decoded raw field structures directly.",
    "tls": "TLS Config",
    "tlsDesc": "Click the lock icon next to the address bar to enable TLS. Supports client certificate, key, and CA certificate file configuration. The icon turns green when enabled.",
    "ai": "AI Assistant",
    "aiDesc": "After configuring an OpenAI-compatible API, use AI Generate in the request editor, AI Analyze to interpret responses, or AI Diagnose to troubleshoot errors.",
    "timeout": "Request Timeout",
    "timeoutDesc": "Set timeout (seconds) next to the Send button. Auto-validates on blur. Default 30s, range 1-3600s.",
    "commandPalette": "Command Palette",
    "commandPaletteDesc": "⌘+K to open. Search methods and run commands. Optional folder filter, method-name-first matching, arrow keys to navigate, Enter to execute.",
    "diff": "Request Diff",
    "diffDesc": "⌘+Click two history records (marked A/B), then click Compare to view line-by-line diffs of request body, response body, and metadata.",
    "theme": "Theme & Language",
    "themeDesc": "Toggle dark/light theme and switch languages from the title bar. Use ⌘++ / ⌘+- to adjust UI font size and ⌘+0 to reset."
  },
